(pcb edge-pin-net-centre-on-outline-garland
  (parser (string_quote ") (space_in_quoted_tokens on) (host_cad "hand") (host_version "1"))
  (resolution um 10)
  (unit um)
  (structure
    (layer Top (type signal) (property (index 0)))
    (layer Bottom (type signal) (property (index 1)))
    (boundary (path pcb 0  0 0  30000 0  30000 20000  17000 20000  17000 6000  13000 6000
                           13000 20000  0 20000  0 0))
    (via "Via[0-1]_600:300_um")
    (rule (width 200) (clearance 200))
  )
  (placement
    (component SMD
      (place A 5000 17000 front 0)
      (place B 25000 17000 front 0)
      (place E 5000 20000 front 0)
      (place C 5000 13000 front 0)
      (place D 25000 13000 front 0)
    )
  )
  (library
    (image SMD (pin Pad 1 0 0))
    (padstack Pad (shape (rect Top -500 -500 500 500)) (attach off))
    (padstack "Via[0-1]_600:300_um" (shape (circle Top 600)) (shape (circle Bottom 600)) (attach off))
  )
  (network
    (net EDGE (pins A-1 B-1 E-1))
    (net CTRL (pins C-1 D-1))
    (class kicad_default EDGE CTRL (circuit (use_via "Via[0-1]_600:300_um")) (rule (width 200) (clearance 200)))
  )
  (wiring
  )
)
